{
  "name": "grailjob/tracker-api-platform",
  "type": "project",
  "description": "API Platform backend for GrailJob Tracker.",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.2",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6",
    "nyholm/psr7": "^1.8",
    "open-telemetry/api": "^1.10",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-symfony": "^1.4",
    "open-telemetry/opentelemetry-logger-monolog": "^1.3",
    "open-telemetry/sdk": "^1.15",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.8",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "^7.4",
    "symfony/mailer": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "pestphp/pest": "^4.7",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "test": "pest",
    "test:coverage": "pest --coverage",
    "lint:container": "@php bin/console lint:container",
    "lint:yaml": "@php bin/console lint:yaml config",
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "7.4.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    }
  }
}
