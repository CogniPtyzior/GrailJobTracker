APP_ENV=dev
APP_SECRET=change-me-in-local-env
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/grailjobtracker?serverVersion=16&charset=utf8"

ADMIN_BOOTSTRAP_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_PASSWORD_FILE=var/secrets/admin_password.secret
TRACKER_SCHEMA=trackers

ACCESS_REQUEST_NOTIFICATION_TO=admin@example.local
MAILER_FROM_EMAIL=no-reply@example.local
MAILER_FROM_NAME="GrailJob Tracker"
