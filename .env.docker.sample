# Local Docker environment for GrailJobTracker.
# Copy and adjust values when needed.

#APP_ENV=dev
APP_ENV=prod

#APP_DEBUG=1
APP_DEBUG=0

APP_TIMEZONE=Europe/Paris

# PostgreSQL already runs outside this project.
# From the container, the host is reached through host.docker.internal.
DATABASE_URL=postgresql://x:y@host.docker.internal:5432/grailjob?serverVersion=17&charset=utf8&currentSchema=trackers

TRACKER_SCHEMA=trackers

MESSENGER_TRANSPORT_DSN=doctrine://default?table_name=trackers.messenger_messages&queue_name=async&auto_setup=0

ACCESS_REQUEST_NOTIFICATION_TO=x@y.fr
MAILER_FROM_EMAIL=no-reply@grailjob.com
MAILER_FROM_NAME=GrailJob
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=x@y.com
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_USE_STARTTLS=0

SESSION_COOKIE_NAME=tracker_session
SESSION_COOKIE_LIFETIME=14400

ADMIN_BOOTSTRAP_EMAIL=admin@grailjob.local
ADMIN_BOOTSTRAP_PASSWORD_FILE=/run/secrets/tracker_admin_password

# Set to debug when you want to use breakpoints in VS Code.
XDEBUG_MODE=off
PHP_IDE_CONFIG=serverName=tracker-api

# Startup automation
WAIT_FOR_DB_TIMEOUT=60
# Run Composer manually after composer.json or composer.lock changes.
AUTO_COMPOSER_INSTALL=0

#COMPOSER_INSTALL_FLAGS=--prefer-dist --no-interaction
COMPOSER_INSTALL_FLAGS=--prefer-dist --no-interaction --no-dev --optimize-autoloader

AUTO_INIT_DB=1
AUTO_MIGRATE=1
AUTO_BOOTSTRAP_ADMIN=1

APP_SECRET=secret

OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=grailjob-api
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
