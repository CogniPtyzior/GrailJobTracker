# Minimal fallback values for local backend commands.
# Copy to .env and adjust local credentials outside Git.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me
APP_TIMEZONE=Europe/Paris

DATABASE_URL="postgresql://app:ChangeMe@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
TRACKER_SCHEMA=trackers

MESSENGER_TRANSPORT_DSN=doctrine://default?table_name=trackers.messenger_messages&queue_name=async&auto_setup=0

MAILER_DSN=null://null
MAILER_FROM_EMAIL=no-reply@example.local
MAILER_FROM_NAME=GrailJob
ACCESS_REQUEST_NOTIFICATION_TO=admin@example.local

SESSION_COOKIE_NAME=tracker_session
SESSION_COOKIE_LIFETIME=14400

DEFAULT_URI=http://localhost

ADMIN_BOOTSTRAP_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_PASSWORD_FILE=var/secrets/admin_password.secret
